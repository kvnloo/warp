# Copy to .env. Do not commit .env.
# TV address is local-only. Discover it; do not guess in git.
TV_IP=
# Development host IP entered in the TV Developer Mode dialog.
HOST_IP=
# Tizen security profile name. Certificate files stay in Tizen Studio data, not here.
TIZEN_PROFILE=JellyfinTV
# Optional override. Defaults to $HOME/tizen-studio.
TIZEN_SDK=
# Optional: file holding the author certificate password. Set it when packaging over ssh,
# where the desktop keyring that stores profile passwords is locked.
TIZEN_AUTHOR_PASS_FILE=
# With TIZEN_AUTHOR_PASS_FILE, point TIZEN_SDK at a private copy of tools/ide whose sdk.info names a
# private data dir with an empty-password profiles.xml, so the global Tizen config is never touched.
