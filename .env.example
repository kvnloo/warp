# Copy to .env. Do not commit .env.
# TV address is local-only. Discover it; do not guess in git.
TV_IP=
# Development host IP entered in the TV Developer Mode dialog.
HOST_IP=
# Tizen security profile name. Certificate files stay in Tizen Studio data, not here.
TIZEN_PROFILE=JellyfinTV
# Optional override. Defaults to $HOME/tizen-studio.
TIZEN_SDK=
