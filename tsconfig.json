{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@warp/plex": ["packages/plex/src/index.ts"],
      "@warp/ui": ["packages/ui/src/index.ts"],
      "@warp/display-lab": ["packages/display-lab/src/index.ts"]
    },
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM"],
    "types": ["vite/client"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/tizen/src/**/*.ts",
    "apps/tizen/src/**/*.tsx"
  ]
}
